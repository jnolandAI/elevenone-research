---
/**
 * The reading of an exhibit, set in a rail. 63 items in the corpus.
 *
 * Same record shape as Annot and a separate object in deck.css: Comment is
 * what goes inside a rail, Annot is what goes on the page.
 *
 * 16 of the 63 items carry s-pad-t--sm, and it is always the first item in
 * its rail, but not every rail's first item carries it: several rails run
 * their first item plain. That makes it an authorial choice per rail rather
 * than a position, so it is a field on the item record rather than derived
 * from the index.
 *
 * One item (S04) carries the same top padding at a different, larger step,
 * written as an ad-hoc inline style rather than the s-pad-t--sm class,
 * because that class is fixed at the smaller step. `pad` is therefore the
 * step value, not a flag: 3 keeps the class every other padded item already
 * uses (so its markup does not move), and 4 is the one observed exception,
 * carried as the same inline style the corpus already writes. If a third
 * step turns up this needs a real look, not a widened type.
 */
interface CommentItem {
  lead: string;
  body: string;
  /** padding-top on this item: 3 is s-pad-t--sm (16 of 63), 4 is the one ad-hoc override. */
  pad?: 3 | 4;
}

interface Props {
  items: CommentItem[];
}

const { items } = Astro.props;
---

<Fragment>
  {
    items.map((item) => (
      <div
        class:list={['s-comment__item', { 's-pad-t--sm': item.pad === 3 }]}
        style={item.pad === 4 ? 'padding-top: var(--ct-space-4)' : undefined}
      >
        <p class="s-comment__lead">{item.lead}</p>
        <p class="s-comment__body">{item.body}</p>
      </div>
    ))
  }
</Fragment>
