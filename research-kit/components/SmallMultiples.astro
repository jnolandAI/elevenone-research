---
import { sparkLayout, type Sparkline } from 'research-kit/lib/exhibits';
import { formatDelta } from 'research-kit/lib/exhibits';

/**
 * Small multiples, for many series that have to be compared rather than
 * overlaid.
 *
 * Every panel shares one vertical domain, computed in sparkLayout across all
 * series. A panel scaled to its own range is a lie by omission, because a
 * reader compares slopes across panels whether or not that was intended, so the
 * shared scale is a property of the layout function and not a caption promise.
 */
interface Props {
  series: Sparkline[];
  /** The index every panel is measured against. */
  base: number;
  alt: string;
}

const { series, base, alt } = Astro.props;
const W = 131;
const H = 60;
const panels = sparkLayout(series, {
  width: W,
  height: H,
  plotTop: 6,
  plotBottom: H - 6,
  x1: 4,
  x2: W - 4,
  base,
});
---

<div class="panels" role="group" aria-label={alt}>
  {
    panels.map((p) => (
      <div class="panel">
        <p class:list={['panel__name', { 'panel__name--mark': p.mark, 'panel__name--total': p.total }]}>
          {p.label}
        </p>
        <svg class="panel__fig" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
          <line class="panel__base" x1="4" y1={p.baseY} x2={W - 4} y2={p.baseY} />
          <polyline
            class:list={['panel__line', { 'panel__line--mark': p.mark, 'panel__line--total': p.total }]}
            points={p.path}
          />
          <circle
            class:list={['panel__end', { 'panel__end--mark': p.mark, 'panel__end--total': p.total }]}
            cx={p.endX}
            cy={p.endY}
            r={p.mark || p.total ? 2.75 : 2.25}
          />
        </svg>
        <p class:list={['panel__val', 'num', { 'panel__val--mark': p.mark, 'panel__val--total': p.total }]}>
          {p.last} <span class="panel__delta">{formatDelta(p.delta, 0)}</span>
        </p>
      </div>
    ))
  }
</div>

<style>
  .panels {
    display: flex;
    flex-direction: row;
    width: 100%;
    gap: var(--ct-space-6);
  }

  .panel {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ct-space-2);
  }

  .panel__fig { width: 100%; height: auto; }

  .panel__name,
  .panel__val {
    font-size: var(--ct-text-sm);
    line-height: var(--ct-leading-5);
    color: var(--ct-text);
  }

  .panel__name--mark,
  .panel__val--mark {
    font-weight: var(--ct-weight-semibold);
    color: var(--ct-mark);
  }

  .panel__name--total,
  .panel__val--total {
    font-weight: var(--ct-weight-medium);
    color: var(--ct-text-strong);
  }

  /* Rich text does not survive as a single run, so the delta is its own
     element rather than an inline span inside the value. Grey and normal
     weight set it off from the value now that italic is retired. */
  .panel__delta {
    color: var(--ct-ex-label-muted);
    font-weight: var(--ct-weight-normal);
  }

  .panel__base {
    stroke: var(--ct-rule);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .panel__line {
    fill: none;
    stroke: var(--ct-ex-fill);
    stroke-width: 1.25;
  }

  .panel__line--mark { stroke: var(--ct-mark); stroke-width: 1.5; }
  .panel__line--total { stroke: var(--ct-ex-series-1); stroke-width: 1.5; }

  .panel__end { fill: var(--ct-ex-fill); }
  .panel__end--mark { fill: var(--ct-mark); }
  .panel__end--total { fill: var(--ct-ex-series-1); }

  /* Five panels at 131px need 655px. Below the md breakpoint they wrap to two
     up, which keeps the shared vertical scale meaningful: panels still line up
     on a row and can still be compared against each other. */
  @media (max-width: 767px) {
    .panels { flex-wrap: wrap; gap: var(--ct-space-4); }
    .panel { flex: 1 1 40%; }
  }
</style>
