---
/**
 * The working-page skeleton.
 *
 * Every working page across Argo and piece 001 opens with `s-stack`, puts
 * the title directly inside it, and closes with a foot and/or a source
 * line, foot first: every page in the corpus that carries both writes them
 * that way, with zero exceptions. Titles and source lines are plain
 * strings, so they are props rather than slots.
 *
 * The body zone takes `s-col` on 47 of 71 working pages (flex, column, full
 * height), so `col` defaults true; the 22 pages without it pass
 * `col={false}`. Two pages use `s-pad-t--lg` in place of `s-pad-t`. 52
 * pages carry a finding, annotation or implication block between the body
 * and the foot: that block is the `close` slot, named because it closes out
 * the body's argument before the footnote and source line. 17 pages carry
 * an s-kpi band between the title stack and the body: that is the `lead`
 * slot. A padding-top on the ct-space-3 token is the only inline style any
 * s-source line carries anywhere in the corpus, so `sourcePad` is a
 * boolean, not a second string prop reopening the expression problem.
 *
 * This component adds no element beyond what the default, `lead` and
 * `close` slots carry. `paint-capture` keys by index path, so one extra
 * wrapper would shift every path after it and turn a 4406-element
 * comparison into noise rather than a finding.
 */
interface Props {
  /** Section label above the title. */
  kicker?: string;
  title: string;
  /** Restatement under the title. */
  sub?: string;
  /** Source or attribution line. Written after the foot, not before it. */
  source?: string;
  /** Note below the body/close zone, above the source. */
  foot?: string;
  /** `s-col` on the body zone: flex, column, full height. 47 of 71 carry it. */
  col?: boolean;
  /** `s-pad-t--lg` instead of `s-pad-t` on the body zone. 2 of 71. */
  padLg?: boolean;
  /**
   * A padding-top on the ct-space-3 token, on the source line. The only
   * inline style any s-source carries in the corpus, so it is a boolean and
   * not a string.
   */
  sourcePad?: boolean;
}

const {
  kicker,
  title,
  sub,
  source,
  foot,
  col = true,
  padLg = false,
  sourcePad = false,
  ...rest
} = Astro.props;
const bodyClass = ['s-grow', padLg ? 's-pad-t--lg' : 's-pad-t', { 's-col': col }];
---

<div class="s-stack" {...rest}>
  {kicker && <p class="s-kicker">{kicker}</p>}
  <h2 class:list={['s-title', { 's-pad-t--sm': Boolean(kicker) }]}>{title}</h2>
  {sub && <p class="s-sub">{sub}</p>}
  <slot name="lead" />
  <div class:list={bodyClass}>
    <slot />
  </div>
  <slot name="close" />
  {foot && <p class="s-foot">{foot}</p>}
  {source && <p class="s-source" style={sourcePad ? 'padding-top: var(--ct-space-3)' : undefined}>{source}</p>}
</div>
