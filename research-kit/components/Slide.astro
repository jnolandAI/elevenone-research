---
/**
 * One slide: a fixed 1280 by 720 canvas with a thin lane down its left.
 *
 * The canvas is fixed because a deck is a fixed medium. It is scaled to the
 * container with a transform rather than by making the type fluid, so what a
 * reader sees in a browser is the same drawing that a 16:9 export produces, at
 * a different size. Container query units do the arithmetic.
 *
 * The lane is 32px on every working slide. A rule that shifts horizontally
 * between slides reads as misregistration rather than as a change of pace.
 * At its head the lane carries the waymarker: one short tick per section,
 * with the current section's tick set in the accent and drawn longer. It is
 * the only signal of position in the deck besides the slide number at the
 * lane's foot; the section numeral that used to sit at the head was removed
 * because two numbers on one rule read as clutter.
 *
 * A cover or a divider takes `full`, which drops the lane and the body
 * padding and hands the slot the whole canvas, because a cover is a field
 * rather than a page.
 */
interface Props {
  /** Slide number, set at the foot of the lane. */
  n: number;
  /** The current section, one-based ("01" to sections). Drives the waymarker. */
  section?: string;
  /** How many sections the deck has, so the waymarker knows how many ticks to draw. */
  sections?: number;
  /** Full-bleed: no lane, no padding. For covers and dividers. */
  full?: boolean;
}

const { n, section, sections = 0, full = false } = Astro.props;
const num = String(n).padStart(2, '0');
const here = section ? parseInt(section, 10) : 0;
const ticks = section && sections > 0 ? Array.from({ length: sections }, (_, i) => i + 1) : [];
---

<div class="scale">
  <div class="slide">
    {
      !full && (
        <div class="slide__lane">
          <div class="slide__way">
            {ticks.map((t) => (
              <div class={t === here ? 'slide__tick slide__tick--here' : 'slide__tick'} />
            ))}
          </div>
          <p class="slide__num">{num}</p>
        </div>
      )
    }
    <div class={full ? 'slide__body slide__body--full' : 'slide__body'}>
      <slot />
    </div>
    {!full && <p class="slide__mark" aria-hidden="true" />}
  </div>
</div>

<style>
  .scale {
    container-type: inline-size;
    width: 100%;
    max-width: var(--ct-slide-w);
    aspect-ratio: 1280 / 720;
    margin-inline: auto;
    /* The frame the canvas sits in. Its own token rather than the hairline
       weight, so a house that rules hairline inside the page can still
       choose to carry no frame around it: those are two decisions and they
       were one value until 2026-08-31. */
    border: var(--ct-frame-w) solid var(--ct-rule);
    overflow: hidden;
  }

  .slide {
    position: relative;
    display: flex;
    width: var(--ct-slide-w);
    height: var(--ct-slide-h);
    background: var(--ct-ground);
    /* The canvas owns its own type, because font-family inherits and .slide is
       the one element every page's content sits inside: one declaration here
       reaches every slotted child regardless of which component drew it.

       Until 2026-08-31 the kit set no font-family anywhere and the canvas
       inherited whatever the host had put on `body`. That read as correct for
       two consumers because both are single-family systems, where inheriting
       the right token and inheriting nothing look identical. The third
       (kit-probe, a serif-display-over-sans-body system) rendered every title
       in its body face and no gate objected: portability.mjs checks paint
       properties, and a font is not one. See tests/contract-coverage.test.ts. */
    font-family: var(--ct-font-body);
    transform-origin: top left;
    /* 100cqw is the container's own width, so the canvas lands exactly on it at
       any size without a media query or a script. */
    transform: scale(calc(100cqw / 1280));
  }

  /* The firm mark, bottom right in the padding band, mirroring the slide
     number at the foot of the lane. The one place the firm's name appears on
     a working page.

     Drawn from --ct-firm-mark rather than written into the markup. This was
     a literal "Noland Advisory" until 2026-08-28, which made it the last
     brand value inside the kit and would have printed one firm's name on the
     other firm's piece. A string token is how the contract already carries
     --ct-art-direction, so this needed no new mechanism.

     Generated content rather than a prop because a prop would have to be
     passed by all 118 slides on the Argo deck to say one thing that never
     varies within a deck, and Astro has no way for a layout to inject it
     through a slot. It is aria-hidden because it is a colophon, not content:
     the firm is already named in the masthead and the document title, and a
     screen reader should not meet it 118 times. */
  /* On ::after rather than on .slide__mark itself: `content` on a bare
     element is CSS Content Level 3 element replacement, which Chromium and
     WebKit have long shipped but Firefox only added in 128. A pseudo-element
     has carried generated content everywhere for twenty years. */
  .slide__mark::after {
    content: var(--ct-firm-mark);
  }

  /* height rather than font-size, because --ct-firm-mark may resolve to a
     url() as easily as to a string: `content` renders an image just as
     happily, so a house with a wordmark or a logo already has somewhere to
     put it and only needed a way to size it. auto by default, which is what
     a text mark wants. */
  .slide__mark::after {
    height: var(--ct-firm-mark-size);
  }

  .slide__mark {
    position: absolute;
    right: var(--ct-slide-pad);
    bottom: var(--ct-space-3);
    font-size: var(--ct-text-xs);
    line-height: var(--ct-leading-4);
    color: var(--ct-text-muted);
  }

  /* The lane carries the waymarker and the page number down one side. Most
     decks do not have a rail: it is this kit's first consumer's own
     signature rather than a general shape, so it is removable. A brand sets
     --ct-lane-w and --ct-lane-rule-w to 0 (and its ticks to 0, which the
     contract's ordering check asks for anyway) and the rail is gone.
     overflow is hidden so a collapsed lane clips its own contents instead of
     spilling them into the measure; at any real width nothing reaches the
     edge, so it changes nothing for a deck that keeps its rail. */
  .slide__lane {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    box-sizing: border-box;
    width: var(--ct-lane-w);
    flex-shrink: 0;
    overflow: hidden;
    /* The right padding separates the ticks from the lane's own rule, and it
       has to collapse with the lane or the lane does not actually go away:
       under box-sizing: border-box a width of 0 against 8px of padding still
       occupies 8px, so --ct-lane-w: 0 left an 8px rail and pushed the content
       column off its own margin by that much. Caught by slidecheck's margin
       check on the run that added it. min() ties the two together without
       asking a brand to remember a second token. */
    padding: var(--ct-slide-pad) min(var(--ct-space-2), var(--ct-lane-w)) var(--ct-slide-pad) 0;
    border-right: var(--ct-lane-rule-w) solid var(--ct-rule);
  }

  .slide__way {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--ct-space-2);
  }

  .slide__tick {
    width: var(--ct-way-tick);
    border-top: var(--ct-rule-w-hair) solid var(--ct-rule-firm);
  }

  .slide__tick--here {
    width: var(--ct-way-tick-here);
    border-top: var(--ct-rule-w-bold) solid var(--ct-mark);
  }

  /* Static by default, which keeps the number at the foot of the lane where
     every existing page has it. A deck with no rail sets --ct-num-pos to
     absolute and gives it an inset, which puts it in the footer band
     instead. Both ends are offered because the footer already has the firm
     mark at one of them: the first cut gave only a right inset, and the
     number landed on top of the wordmark. Doing it this way rather than by moving the element keeps the
     markup identical for everyone: the number changes where it sits without
     changing where it is in the document. */
  .slide__num {
    position: var(--ct-num-pos);
    left: var(--ct-num-left);
    right: var(--ct-num-right);
    bottom: var(--ct-num-bottom);
    font-size: var(--ct-text-xs);
    line-height: var(--ct-leading-4);
    color: var(--ct-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .slide__body {
    position: relative;
    flex: 1;
    min-width: 0;
    padding: var(--ct-slide-pad);
  }

  /* The footer divider: a rule across the measure above the footer
     furniture, which is one of the commonest things a house template
     carries and which this kit could not draw. Zero by default, so a deck
     that does not want one pays nothing. Drawn as a pseudo-element rather
     than a new div because adding an element would shift every index path
     after it and turn paint-diff from a proof into noise. */
  .slide__body::after {
    content: '';
    position: absolute;
    left: var(--ct-slide-pad);
    right: var(--ct-slide-pad);
    bottom: var(--ct-foot-rule-pad);
    border-top: var(--ct-foot-rule-w) solid var(--ct-rule);
  }

  .slide__body--full {
    padding: 0;
  }
</style>
