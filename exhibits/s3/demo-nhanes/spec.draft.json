{
  "source": {"kind": "csv", "path": "nhanes-2017-2018.csv"},
  "model": {
    "method": "estimate",
    "method_version": "S3.0.0",
    "design": {"type": "stratified_cluster", "ids": ["psu"], "strata": "stratum", "weights": "wt_exam", "fpc": [],
               "fpc_kind": null, "nest": true, "lonely_psu": "refuse", "df": "design"},
    "estimates": [
      {"id": "obesity", "statistic": "proportion", "variable": "obese"},
      {"id": "obesity_sex", "statistic": "proportion", "variable": "obese", "by": "adult_sex"},
      {"id": "obesity_race", "statistic": "proportion", "variable": "obese", "by": "adult_race"},
      {"id": "bmi", "statistic": "mean", "variable": "bmi", "by": "adult"},
      {"id": "bmi_median", "statistic": "quantile", "variable": "bmi", "probabilities": [0.5], "by": "adult"}
    ],
    "item_missing": "drop_per_estimate",
    "proportion_ci": "beta",
    "quantile": {"rule": "math", "interval": "woodruff_wald"},
    "design_effect": ["kish", "srswor"],
    "domain_rule": "subpopulation",
    "confidence_level": 0.95,
    "engine": "python",
    "seed": 0
  }
}
