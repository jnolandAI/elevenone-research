{
  "name": "elevenone-research",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check-briefs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "slides": "node research-kit/scripts/slidecheck.mjs",
    "audit": "node research-kit/scripts/audit.mjs --profile brief src/pages/pieces",
    "density": "node research-kit/scripts/density.mjs --profile brief",
    "art": "node research-kit/scripts/generate-art.mjs --manifest art/piece-001.manifest.json --out public/assets/art --adapter src/styles/contract-adapter.css",
    "art:prompts": "npm run art -- --prompts",
    "art:import": "npm run art -- --import art/staged",
    "artcheck": "node research-kit/scripts/artcheck.mjs --manifest art/piece-001.manifest.json --out public/assets/art --src src/pages/pieces --adapter src/styles/contract-adapter.css",
    "htmlcheck": "node research-kit/scripts/html-capture.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "astro": "^5.0.0",
    "research-kit": "file:research-kit"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.49.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
