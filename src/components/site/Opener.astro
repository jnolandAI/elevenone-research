---
interface Props {
  kicker?: string;
  title: string;
  standfirst?: string;
}
const { kicker, title, standfirst } = Astro.props;
---
<header class="opener frame">
  {kicker && <p class="kicker mono">{kicker}</p>}
  <h1>{title}</h1>
  {standfirst && <p class="stand">{standfirst}</p>}
</header>

<style>
  /* Left-aligned at the frame's edge, never centred. The research pages
     open the same way, and a centred title over a left-set body reads as a
     template. */
  .opener { padding-top: 84px; }
  .kicker {
    font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase;
    color: var(--g80); margin: 0 0 18px;
  }
  h1 {
    font-size: clamp(38px, 4.8vw, 56px); font-weight: 500;
    letter-spacing: var(--tracking-tight); line-height: 1.05;
    margin: 0; color: var(--ink); max-width: 18ch;
  }
  .stand { font-size: 19px; line-height: 1.6; color: var(--g80); max-width: 52ch; margin: 22px 0 0; }

  @media (max-width: 760px) {
    .opener { padding-top: 56px; }
  }
</style>
