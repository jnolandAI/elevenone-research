---
interface Props { id: string; }
const { id } = Astro.props;
---
<span class="cl" id={`t-${id}`} data-for={id}><slot /></span><a
  class="cm" href={`#c-${id}`} data-for={id}
  aria-label={`Show the working behind claim ${id}`}>{id}</a>

<style>
  /* a load-bearing sentence, marked in the prose and tied to the rail */
  .cl {
    color: var(--ink); font-weight: 500; border-radius: 5px;
    transition: background .35s var(--ez), box-shadow .35s var(--ez);
  }
  .cl:global(.lit) {
    background: rgba(213,213,210,.75);
    box-shadow: 0 0 0 5px rgba(213,213,210,.75);
  }
  a.cm {
    font-family: var(--font-mono);
    font-size: 9.5px; font-weight: 400; text-decoration: none; color: var(--g80);
    vertical-align: .42em; margin-left: 4px; padding: 2px 5px;
    border-radius: var(--pill); background: rgba(20,20,18,.055);
    transition: background .28s, color .28s;
  }
  a.cm:hover, a.cm:focus-visible { background: var(--ink); color: #fff; }
</style>
