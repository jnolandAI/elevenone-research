---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

interface Props {
  /** Rendered size in px. Chooses the cut. Minimum 16. */
  size: number;
  /** Dark grounds only. There is no third value. */
  inverse?: boolean;
  /**
   * Set only when the mark stands alone. Beside the wordmark it is decorative
   * and naming it twice makes a screen reader say the brand twice.
   */
  label?: string;
}

const { size, inverse = false, label } = Astro.props;

// Rule 3 of docs/mark.md. Below 16px the small cut loses the scatter and the
// idea goes with it, so this is an error rather than a clamp.
if (size < 16) {
  throw new Error(`Mark: minimum size is 16px, got ${size}px. See docs/mark.md.`);
}

// Three cuts, not one drawing scaled. A halftone changes line screen for
// newsprint; a mark changes it for a favicon. Scaling the display cut down to
// 16px turns 112 dots into mud, and the small cut's 23 dots turn to specks
// below 21px, which is exactly where Nav and Footer sit.
const cut = size >= 33 ? '' : size >= 21 ? '-small' : '-micro';
const tone = inverse ? '-inverse' : '';
// Resolved against this file, not the working directory. A cwd-relative path
// works only while the build and the tests are both launched from the repo
// root, and fails with ENOENT the moment either is not.
const file = fileURLToPath(
  new URL(`../../public/assets/mark/mark${cut}${tone}.svg`, import.meta.url),
);

let svg = readFileSync(file, 'utf8');

// The file carries role="img", an aria-label and a <title> for standalone use.
// Strip all three first, then put back only what this instance needs: naming
// the mark twice beside the wordmark makes a screen reader say the brand twice.
svg = svg
  .replace(/<title>.*?<\/title>/, '')
  .replace(/\s*aria-label="[^"]*"/, '')
  .replace('role="img"', label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"');

// Sized inline rather than in a class, so the mark cannot be stretched by a
// parent's layout. Rule 5: never rotated, stretched, outlined or shadowed.
svg = svg.replace('<svg ', `<svg style="width:${size}px;height:${size}px;display:block;flex:none" `);

// The four SVGs are generated by scripts/render_mark.py. If its serialisation
// ever changes (single quotes, a pretty-printed <title>, a different attribute
// order) the replacements above quietly match nothing and the file's own
// standalone accessible name survives into a decorative instance. Fail the
// build instead: a mark that announces the brand twice to a screen reader is
// exactly the kind of thing nobody notices for a year.
const labelCount = (svg.match(/aria-label=/g) ?? []).length;
if (labelCount !== (label ? 1 : 0)) {
  throw new Error(
    `Mark: expected ${label ? 1 : 0} aria-label in ${file}, found ${labelCount}. ` +
      'The generated SVG format has probably changed; update the rewrite above.',
  );
}
if (!label && !svg.includes('aria-hidden="true"')) {
  throw new Error(`Mark: could not mark ${file} decorative. Check the generated SVG format.`);
}
---
<Fragment set:html={svg} />
