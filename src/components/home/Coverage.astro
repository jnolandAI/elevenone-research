---
import { dotAsset, SUBJECTS } from '../../lib/dot';

const cards = Object.entries(SUBJECTS).map(([id, meta]) => ({
  id,
  ...meta,
  img: dotAsset(id, 'card'),
}));
---
<section class="coverage frame" aria-labelledby="coverage-h">
  <h2 id="coverage-h">Subjects the imagery covers</h2>
  <p class="intro">Each subject below is pushed through the same halftone screen, at fixed constants. These are the subjects the system can draw today. They describe coverage of the drawing system, not work delivered.</p>

  <ul class="grid">
    {cards.map((c) => (
      <li>
        <img src={c.img.src} width={c.img.width} height={c.img.height} alt={c.img.alt} loading="lazy" decoding="async" />
        <p class="name">{c.name}</p>
        <p class="covers">{c.covers}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  /* 84px top rather than the 44px this shipped with: at four columns the
     strip is denser and darker than the six-column original it replaces,
     so it needs the same section-opening weight of top padding HomeHero
     carries, not the tighter spacing a quiet six-thumbnail row could get
     away with. That is the quieting, not a smaller or dimmer render: real
     air between this section and Working above it, so the strip reads as
     its own appendix-like beat rather than piling straight onto the load
     path card above. */
  .coverage { padding: 84px 0 30px; }
  h2 { font-size: 18px; font-weight: 600; letter-spacing: -.02em; margin: 0; color: var(--ink); }
  .intro { font-size: 13.5px; line-height: 1.7; color: var(--g80); margin: 10px 0 0; max-width: var(--read); }

  /* Four columns, not the six this shipped with. Six put each render in a
     162px box at 1440/DPR1, a 5.7x downscale from its 920px native width
     that the imagery doc's own recognition test failed: a 1:1 crop reads
     as a grey smear, not a container port. Four columns lands cards at
     roughly 249px, clearing the doc's "identifiable at roughly 200px wide"
     bar with room, without going as large (and as heavy against the hero)
     as three columns would. */
  .grid {
    list-style: none; margin: 26px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px 16px;
  }
  /* Native size, never resampled: the img box scales, the source does not.
     `darken` for the same reason as HomeHero: the render's flat #FCFCFB field
     would otherwise show as a light rectangle against .ground, and .ground is
     fixed, so the band behind these cards changes with scroll. Taking the
     per-channel minimum makes the field lose to the ground everywhere and
     keeps the dot at its exact ink. Quieting is done with scale, never by
     dimming the ink: opacity and contrast filters push #131312 up into the
     g80 range and make it drift card to card. */
  .grid img { width: 100%; height: auto; display: block; border-radius: var(--r-s); mix-blend-mode: darken; }
  .name { font-size: 11px; font-weight: 600; color: var(--g80); margin: 8px 0 0; letter-spacing: -.008em; }
  .covers { font-size: 10.5px; line-height: 1.5; color: var(--g80); margin: 2px 0 0; }

  @media (max-width: 860px) { .grid { grid-template-columns: repeat(3, 1fr); gap: 18px; } }
  @media (max-width: 520px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .covers { display: none; }
  }
</style>
