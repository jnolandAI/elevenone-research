---
// No claim, source, assumption or falsifier is shown here. Nothing is
// published yet, so there is no brief to draw one from, and a filled-in
// example on the indexed homepage would assert a finding a reader has no way
// to check. This teaches the device instead of demonstrating it: what each
// row is for, and why leaving one out would make the claim above it
// unreadable.
const rows = [
  {
    label: 'Claim',
    body: 'One sentence built to be checked, never a hedge worded to survive any challenge.',
  },
  {
    label: 'Source',
    body: 'Names where the underlying data came from, specific enough that a reader could go verify it directly rather than take the claim on trust.',
  },
  {
    label: 'Assumption',
    body: 'States the condition that has to hold for the claim to mean anything, including the situations where that condition runs thin, since an assumption nobody names is an assumption nobody can challenge.',
  },
  {
    label: 'Falsifier',
    body: 'States what would prove the claim wrong and says plainly whether that test has actually been run.',
  },
];
---
<section class="working frame" aria-labelledby="working-h">
  <h2 id="working-h">Every claim carries its working</h2>
  <p class="intro">A brief marks the sentences it rests on. Below is what the four rows carry, and why each one has to be there. The conclusion is never rendered firmer than the weakest claim beneath it.</p>

  <div class="block">
    <dl>
      {rows.map((r) => (
        <div class:list={['row', { claimrow: r.label === 'Claim' }]}>
          <dt>{r.label}</dt>
          <dd>{r.body}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .working { padding: 30px 0 10px; }
  h2 { font-size: 22px; font-weight: 600; letter-spacing: -.024em; margin: 0; color: var(--ink); }
  .intro { font-size: 16.5px; line-height: 1.76; color: var(--g80); margin: 14px 0 0; max-width: var(--read); }

  .block {
    margin: 30px 0 0; padding: 28px 30px 24px; border-radius: var(--r-l);
    background: linear-gradient(160deg, #FFFFFF 0%, #F7F7F6 100%);
    box-shadow: var(--e1); max-width: var(--doc);
  }
  dl { margin: 0; display: grid; gap: 20px 24px; }
  .row { display: grid; grid-template-columns: 108px 1fr; gap: 24px; align-items: baseline; }
  .row + .row { padding-top: 20px; border-top: 1px solid var(--g20); }
  dt { font-size: 11.5px; color: var(--g70); line-height: 1.6; }
  dd { margin: 0; font-size: 13.5px; line-height: 1.7; color: var(--g80); max-width: 70ch; }

  /* The claim is the sentence the other three rows exist to support: it
     carries the same 108px label column as everything else, so it reads as
     a row in the apparatus rather than a caption bolted above it, but its
     text is set larger and darker than the working beneath it. */
  .claimrow dd { font-size: 16px; line-height: 1.6; color: var(--ink); font-weight: 500; max-width: 62ch; }

  @media (max-width: 620px) {
    .row { grid-template-columns: 1fr; gap: 3px; }
    .row + .row { padding-top: 16px; }
  }
</style>
