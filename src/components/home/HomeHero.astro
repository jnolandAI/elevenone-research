---
import { fieldAsset } from '../../lib/field';

interface Props {
  headline: string;
  standfirst: string;
}
const { headline, standfirst } = Astro.props;

// Two renders, chosen by the picture element. The image cannot follow the
// viewport, so a tall crop is drawn for narrow screens rather than squeezed
// out of the wide one. docs/field.md.
const wide = fieldAsset('home-wide');
const narrow = fieldAsset('home-narrow');
---
<div class="band">
  <picture class="field">
    <source media="(max-width: 899px)" srcset={narrow.src} width={narrow.width} height={narrow.height} />
    <img
      src={wide.src}
      width={wide.width}
      height={wide.height}
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="frame hero">
    <h1>{headline}</h1>
    <p class="stand">{standfirst}</p>
  </div>
</div>

<style>
  /* Full bleed, and it starts at the top of the page. main begins below the
     nav, so the band pulls itself up by the nav's height and pads by the
     same amount: the nav then sits on the band, transparent, and the h1
     stays inside main where the skip link can reach it. Both numbers are
     --nav-h so they cannot disagree.

     The ground is --ink before the image arrives and past its edges, which
     is also the ground the render was drawn on. */
  .band {
    position: relative;
    background: var(--ink);
    margin-top: calc(-1 * var(--nav-h));
    padding-top: var(--nav-h);
    overflow: hidden;
  }

  /* The image fills the band and is cropped, which a field is drawn to
     survive: a mass whose centre is off the frame never shows where it
     begins, so a crop has no edge to find. Anchored left because BLOBS_HOME
     keeps the left third quiet and that is where the type is. No blend mode:
     the render carries its own ground, so there is nothing to blend with. */
  .field { position: absolute; inset: 0; display: block; }
  .field img {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: left center;
  }

  .hero { position: relative; padding-top: 84px; padding-bottom: 96px; }
  h1 {
    font-size: clamp(33px, 5vw, 58px); font-weight: 500; letter-spacing: -.036em;
    line-height: 1.05; margin: 0; color: var(--band-text); max-width: 15ch;
  }
  .stand { font-size: 17.5px; line-height: 1.66; color: var(--band-text-muted); max-width: 48ch; margin: 26px 0 0; }

  @media (max-width: 899px) {
    .hero { padding-top: 60px; padding-bottom: 64px; }
  }
</style>
