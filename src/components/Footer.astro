---
import Mark from './Mark.astro';
---
<footer>
  <div class="frame">
    <div>
      <div class="n"><Mark size={17} />Eleven One <span>Research</span></div>
      <p>Independent research and analysis for decisions that are hard to reverse. Briefs are free to read, in full, and always will be.</p>
    </div>
    <nav aria-label="Footer">
      <a href="/briefs">Briefs</a>
      <a href="/reports">Reports</a>
      <a href="/method">Method</a>
      <a href="/about">About</a>
    </nav>
  </div>
</footer>

<style>
  footer { margin-top: 96px; padding: 40px 0 76px; box-shadow: inset 0 1px 0 rgba(20,20,18,.07); }
  footer :global(.frame) { display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: baseline; }
  .n {
    font-size: 13.5px; font-weight: 600; letter-spacing: -.018em;
    display: inline-flex; align-items: center; gap: 9px;
  }
  .n span { color: var(--g80); font-weight: 500; }
  p { font-size: 12.5px; color: var(--g80); margin: 8px 0 0; max-width: 44ch; line-height: 1.72; }
  nav { display: flex; gap: 18px; margin-left: auto; }
  a { font-size: 13px; color: var(--g80); text-decoration: none; }
  a:hover { color: var(--ink); }
</style>
