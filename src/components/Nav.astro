---
import Mark from './Mark.astro';

interface Props {
  current?: 'briefs' | 'reports' | 'method' | 'about';
  print?: boolean;
}
const { current, print = false } = Astro.props;

const links = [
  { key: 'briefs', label: 'Briefs', href: '/' },
  { key: 'reports', label: 'Reports', href: '/reports' },
  { key: 'method', label: 'Method', href: '/method' },
  { key: 'about', label: 'About', href: '/about' },
] as const;
---
<header class="nav">
  <div class="frame">
    <a class="brand" href="/">
      <Mark size={19} />Eleven One <span>Research</span>
    </a>
    <nav aria-label="Primary">
      {links.map((l) => (
        <a class="l" href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    {print && (
      <button class="print" type="button" data-print hidden>Print</button>
    )}
  </div>
</header>

<script>
  // The brief is open in web and on paper. There is no file to download and
  // the button does not say there is.
  //
  // It ships hidden and this reveals it. Without that, a reader with
  // JavaScript off gets a button that renders, takes focus, looks actionable
  // and does nothing, which is the same dishonesty as labelling it "Download
  // PDF" while no file exists. Printing stays available through the browser's
  // own command either way, so hiding the control costs that reader nothing.
  const printButton = document.querySelector<HTMLButtonElement>('[data-print]');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 40;
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    background: linear-gradient(180deg, rgba(250,250,249,.88), rgba(250,250,249,.64));
    box-shadow: 0 1px 0 rgba(20,20,18,.06), 0 8px 24px rgba(20,20,18,.04);
  }
  .nav :global(.frame) {
    display: flex; align-items: center; gap: 24px;
    padding-top: 14px; padding-bottom: 14px;
  }
  .brand {
    font-size: 15px; font-weight: 600; letter-spacing: -.02em;
    text-decoration: none; color: var(--ink); white-space: nowrap;
    display: inline-flex; align-items: center; gap: 10px;
  }
  .brand span { color: var(--g70); font-weight: 500; }
  nav { display: flex; gap: 20px; margin-left: auto; }
  .l { font-size: 13.5px; color: var(--g70); text-decoration: none; transition: color .25s; }
  .l:hover, .l[aria-current] { color: var(--ink); }
  .print {
    font-family: inherit; font-size: 13px; color: var(--ink); cursor: pointer;
    padding: 8px 15px; border: 0; border-radius: var(--pill);
    background: rgba(255,255,255,.74); box-shadow: var(--e1);
    transition: transform .3s var(--ez), box-shadow .3s; white-space: nowrap;
  }
  .print:hover { transform: translateY(-1px); box-shadow: var(--e2); }

  @media (max-width: 900px) {
    nav { display: none; }
  }
</style>
