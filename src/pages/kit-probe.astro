---
/**
 * Temporary. The first Eleven One route that renders through research-kit.
 * Exists to prove Panels, the component with no <style> block of its own,
 * is styled once the kit's page vocabulary is available here. Delete once
 * the real piece renders.
 */
import Piece from '../layouts/Piece.astro';
import Slide from 'research-kit/components/Slide.astro';
import Panels from 'research-kit/components/Panels.astro';

const panels = [
  { head: 'Firm', meta: 'three claims', items: ['The percentiles are exact.', 'The universe is every SEC registrant reporting both lines.'], note: 'Restated without qualification.' },
  { head: 'Qualified', meta: 'one claim', items: ['Interpolated from 2.6-point bins, good to about a point.'], mark: true },
  { head: 'Untested', meta: 'one claim', items: ['Whether the 221 excluded filers are random with respect to margin.'], note: 'We have not tested that.' },
];
---
<Piece title="Kit probe | Eleven One Research" description="Temporary probe.">
  <Slide n={1} section="01" sections={3}>
    <p class="s-kicker">Probe</p>
    <h2 class="s-title">Panels renders styled under this brand</h2>
    <div class="s-pad-t--lg">
      <Panels panels={panels} lead />
    </div>
  </Slide>
</Piece>
