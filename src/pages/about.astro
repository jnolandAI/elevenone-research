---
import Base from '../layouts/Base.astro';
import Opener from '../components/site/Opener.astro';
import Section from '../components/site/Section.astro';
import Ledger from '../components/site/Ledger.astro';

// The roles are listed most recent first. The order was taken from the order
// in which John lists them elsewhere and is his to correct.
const roles = [
  { label: 'Vice president, integrations and strategic projects', body: 'A private-equity-backed manufacturer of anatomic pathology products.' },
  { label: 'Management consultant', body: 'A middle-market M&A and operations consulting firm.' },
  { label: 'Integration lead', body: 'A private-equity-backed specialty industrial manufacturer.' },
  { label: 'Management consultant', body: 'Alvarez & Marsal.' },
];
---
<Base
  title="About · Eleven One Research"
  description="Eleven One Research is an independent research and analysis practice producing written work for investors and the management teams of the companies they own."
  current="about"
>
  <Opener
    kicker="Eleven One Research"
    title="About"
    standfirst="Eleven One Research is an independent research and analysis practice. It produces written work for investors and for the management teams of the companies they own."
  />

  <Section label="The practice" id="practice">
    <p>The practice sells written analysis, delivered as a document, on decisions such as an acquisition, a market entry, a competitive response or a question in front of a board. Its readers are private equity deal teams and operating partners, corporate strategy teams and management consultants. Every piece of work names its sources and includes the data behind its figures.</p>
  </Section>

  <Section label="Background" id="background">
    <Ledger rows={roles} />
  </Section>

  <Section label="Contact" id="contact">
    <p>Inquiries can be sent to <a href="mailto:info@elevenoneresearch.com">info@elevenoneresearch.com</a>.</p>
  </Section>
</Base>
